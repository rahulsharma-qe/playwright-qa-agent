{
  "name": "playwright-qa-agent",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test framework for QA teams",
  "scripts": {
    "pretest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/clean-run-output.ts",
    "test": "playwright test --grep-invert @seed",
    "pretest:sanity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/clean-run-output.ts",
    "test:sanity": "playwright test --grep @sanity",
    "test:seed": "playwright test --grep @seed",
    "pretest:public-site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/clean-run-output.ts",
    "test:public-site": "TEST_ENV=public-site playwright test --grep-invert @seed",
    "test:unit": "playwright test --project unit",
    "pretest:ready": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/clean-run-output.ts",
    "test:ready": "playwright test --grep-invert @seed --repeat-each=3 --workers=2",
    "report:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/secret-scan.mjs redact && allure generate allure-results --clean -o allure-report --name \"Toolshop UI tests\" && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON support/secret-scan.mjs check",
    "report": "npm run report:build && allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@estruyf/github-actions-reporter": "1.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "dotenv": "18.0.9",
    "typescript": "7.0.2"
  },
  "private": true,
  "overrides": {
    "dompurify": "3.4.17"
  }
}
