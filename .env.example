# Copy to .env only if you want another Toolshop copy; all have defaults. No account values: each run makes its own.
# The defaults are the pinned local copy (start it with ci/start-toolshop.sh). For the public site, use
# npm run test:public-site, or BASE_URL=https://practicesoftwaretesting.com and API_URL=https://api.practicesoftwaretesting.com.
BASE_URL=http://localhost:4200
API_URL=http://localhost:8091
# Which Toolshop version; sprint5-with-bugs only for the planted-bug run.
SPRINT=sprint5
